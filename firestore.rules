rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Dengue & Chikungunya Entries collection
    match /dengueEntries/{dengueId} {
      allow read: if true;
      allow write: if isValidId(dengueId);
    }

    // BS Data Entry collection
    match /bsDataEntry/{entryId} {
      allow read: if true;
      allow write: if isValidId(entryId);
    }

    // Village Details collection
    match /villageDetails/{detailId} {
      allow read: if true;
      allow write: if isValidId(detailId);
    }

    // Subcenter Master collection
    match /subcenterMaster/{scId} {
      allow read: if true;
      allow write: if isValidId(scId);
    }

    // Employee Master collection
    match /employeeMaster/{empId} {
      allow read: if true;
      allow write: if isValidId(empId);
    }

    // Villages Master collection
    match /villagesMaster/{vilId} {
      allow read: if true;
      allow write: if isValidId(vilId);
    }

    // Month Master collection
    match /monthMaster/{monthId} {
      allow read: if true;
      allow write: if isValidId(monthId);
    }

    // App config & metadata
    match /appConfig/{configId} {
      allow read, write: if isValidId(configId);
    }

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
